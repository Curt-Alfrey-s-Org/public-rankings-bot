# Rankings Bot — STAGING env template (placeholders only; NEVER commit real values).
# Used by docker-compose-staging.yml (compose interpolation). Copy to the git-ignored
# .env (or export the variables, see staging.env.sh.example) and replace every CHANGE_ME.
# Staging runs in production mode (DEBUG unset): the API refuses to start without
# JWT_SECRET, BOT_API_KEY and, on first boot, STAGING_SUPER_ADMIN_PASSWORD.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
BOT_API_KEY=CHANGE_ME_openssl_rand_hex_32
XAI_API_KEY=
STAGING_SUPER_ADMIN_USERNAME=CHANGE_ME_super_admin_username
STAGING_SUPER_ADMIN_PASSWORD=CHANGE_ME
STAGING_ADMIN_PASSWORD=CHANGE_ME
STAGING_DIRECTOR_PASSWORD=CHANGE_ME
STAGING_USER_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
HOST_UID=1000
HOST_GID=1000
