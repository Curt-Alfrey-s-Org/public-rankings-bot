# Rankings Bot — copy to .env and set values as needed

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
# Production: PostgreSQL on docker-compose 'postgres' service
DATABASE_URL=postgresql://rankingsbot_user:change-me@postgres:5432/rankingsbot

# PostgreSQL Credentials (used by docker-compose)
POSTGRES_DB=rankingsbot
POSTGRES_USER=rankingsbot_user
POSTGRES_PASSWORD=change-me

# Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# API
# ============================================================================
API_PORT=8003
API_URL=http://127.0.0.1:8003
CORS_ORIGINS=
DEBUG=false
LOG_LEVEL=INFO

# Docker Compose: match host deploy user for API/celery bind mounts (frontend, logs).
# HOST_UID=1000
# HOST_GID=1000

# ============================================================================
# AUTH (bootstrap credentials — used only to create missing users at startup,
# never at login; see api/auth.py and docs/AUTH_DESIGN.md)
# ============================================================================
# REQUIRED in production: production/docker-compose.prod.yml uses the Compose
# required-variable form (${VAR:?error}) for the four *_PASSWORD values below.
BOT_API_KEY=change-me
TEST_CENTER_DATABASE_URL=postgresql://rankingsbot_user:change-me@postgres:5432/rankings_testcenter
JWT_SECRET=change-me
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DIRECTOR_USERNAME=director
DIRECTOR_PASSWORD=change-me
USER_USERNAME=user
USER_PASSWORD=change-me

# ============================================================================
# EMAIL NOTIFICATIONS (optional)
# ============================================================================
# SENDGRID_API_KEY=change-me
# FROM_EMAIL=rankings@example.com
# BASE_URL=https://rankings-bot.example.com

# ============================================================================
# CAPTCHA (optional)
# ============================================================================
# RECAPTCHA_SECRET_KEY=change-me
RECAPTCHA_MIN_SCORE=0.5

# ============================================================================
# Ollama (optional local LLM)
# ============================================================================
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=60
OLLAMA_MODEL_STRUCTURED=mistral:7b
OLLAMA_MODEL_CHAT=llama3.1:8b

# ============================================================================
# LiteLLM (optional)
# ============================================================================
# LITELLM_ENABLED=false
# LITELLM_BASE_URL=http://127.0.0.1:4000
# LITELLM_API_KEY=change-me
