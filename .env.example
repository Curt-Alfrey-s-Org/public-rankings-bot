# Rankings Bot — copy to .env and set values as needed

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
# Production: PostgreSQL on docker-compose 'postgres' service
DATABASE_URL=postgresql://user:your_secure_password@postgres:5432/rankingsbot

# PostgreSQL Credentials (used by docker-compose)
POSTGRES_DB=rankingsbot
POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password

# Connection Pool Settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# PostgreSQL required.
# DATABASE_URL=postgresql://user:pass@localhost:5432/rankings

# ============================================================================
# API
# ============================================================================
API_PORT=8003
API_URL=http://127.0.0.1:8003
CORS_ORIGINS=
DEBUG=false
LOG_LEVEL=INFO

# Docker Compose: match host deploy user for API/celery bind mounts (frontend, logs).
# start.sh / full_deploy.sh generate .env.compose-host-user; set manually if you run compose without scripts.
# HOST_UID=1000
# HOST_GID=1000

# ============================================================================
# AUTH (bootstrap credentials — used only to create missing users at startup,
# never at login; see api/auth.py and docs/AUTH_DESIGN.md)
# ============================================================================
# REQUIRED in production: production/docker-compose.prod.yml uses the Compose
# required-variable form (${VAR:?error}) for the four *_PASSWORD values below,
# so a missing value fails `docker compose up` loudly instead of falling back
# to a known temporary password. 8+ chars with upper, lower, number, special.
# Middleware returns 503 if unset. Compose interpolates VITE_API_KEY from this.
BOT_API_KEY=Example-Pass-03!
# Test Center DB (required by docs/ENV_VARS.md and production compose).
TEST_CENTER_DATABASE_URL=postgresql://user:your_secure_password@postgres:5432/rankingsbot_testcenter
JWT_SECRET=Example-Pass-04!
SUPER_ADMIN_USERNAME=tornybotca1
SUPER_ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: use hash instead of plain password
# ADMIN_PASSWORD_HASH=

DIRECTOR_USERNAME=director
DIRECTOR_PASSWORD=change-me
# Optional: DIRECTOR_PASSWORD_HASH=

USER_USERNAME=user
USER_PASSWORD=change-me

# ============================================================================
# EMAIL NOTIFICATIONS (ranking change alerts). Optional; if not set, notifications are logged only.
# ============================================================================
# NOTIFY_UNSUBSCRIBE_BASE_URL=https://your-api-domain.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=rankings@example.com
# Optional: POST refresh summary to a URL (JSON body: timestamp, wpba, wpa)
# WEBHOOK_URL=https://your-server.com/webhook/rankings-refresh

# Email Service Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=user@example.com
BASE_URL=https://rankings-bot.example.com

# ============================================================================
# CAPTCHA Configuration (Google reCAPTCHA v3)
# ============================================================================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_MIN_SCORE=0.5
# ============================================================================
# Ollama (optional local LLM — name resolution, extraction, narratives, coach)
# ============================================================================
# From Docker on the same LAN, use the host IP where Ollama runs (not host.docker.internal
# unless your compose stack defines it). Example: Win11 primary at 192.0.2.10
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://192.0.2.10:11434
OLLAMA_TIMEOUT=60
OLLAMA_MODEL_STRUCTURED=mistral:7b
OLLAMA_MODEL_CHAT=llama3.1:8b

# ============================================================================
# LiteLLM / ALFa AI cluster (optional — routes Ask AI + public demo via proxy)
# ============================================================================
# When true, narrative AI uses the LiteLLM proxy (Ollama/Petals backends). See docs/ENV_VARS.md
# and docs/ALFA_AI_HOW_TO_USE.md. Match LITELLM_API_KEY to alfa-ai deploy/.env LITELLM_MASTER_KEY.
# LITELLM_ENABLED=false
# LITELLM_BASE_URL=http://alfa-ai-litellm:4000   # prod: shared tunnel_network; or http://127.0.0.1:8013 host/dev
# LITELLM_API_KEY=
# LITELLM_TIMEOUT=600
# Trust-zone model aliases (must exist in alfa-ai deploy/litellm_config.yaml):
# LITELLM_MODEL_PUBLIC=public-chat
# LITELLM_MODEL_PAGE_QUESTION=app-chat
# LITELLM_MODEL_CHAT=app-chat
# Optional separate proxy keys (same master key or LiteLLM virtual keys):
# LITELLM_API_KEY_PUBLIC=
# LITELLM_API_KEY_APP=
