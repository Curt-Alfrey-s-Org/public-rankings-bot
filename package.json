{
  "name": "rankings-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:setup": "cd ios && bundle install && bundle exec pod install",
    "ios:open": "open ios/RankingsBot.xcodeproj",
    "clean": "cd android && ./gradlew clean && cd ..",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "install:android": "cd android && ./gradlew installRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@react-navigation/bottom-tabs": "^7.15.2",
    "@react-navigation/drawer": "^7.9.2",
    "@react-navigation/native": "^7.1.31",
    "@react-navigation/native-stack": "^7.12.0",
    "@react-navigation/stack": "^7.8.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.2",
    "react-native-dotenv": "^3.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}