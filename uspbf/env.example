# USPBF (example.com) — copy to .env and set values.
# Docker: use ./scripts/start.sh (creates external volumes uspbf_wp_data / uspbf_db_data if needed).
# Networks: tunnel_network (external) + uspbf_db bridge — same model as alfaqd-website.
# Tunnel token: Cloudflare Zero Trust → Tunnels → cf-uspbf → Configure.
# Optional for ./start.sh: if empty, stack still starts; run ./scripts/start_cf_uspbf.sh after setting.

USPBF_TOKEN=

# REQUIRED. Same value as rankings-bot-api BOT_API_KEY. uspbf-nginx refuses to start without it.
# Injected server-side by nginx only for the allowlisted public endpoints the static site calls
# (nginx-config/snippets/uspbf-public-api-allowlist.conf). Allowed characters: A-Z a-z 0-9 . _ ~ + / = -
# Generate e.g. with: openssl rand -hex 32   (never commit the real value)
BOT_API_KEY=

# WordPress / MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=
