# USPBF — copy to .env and set values.
# From uspbf/: docker compose up -d (or ./scripts/start.sh to create external volumes).

USPBF_TOKEN=

# REQUIRED. Same value as rankings-bot-api BOT_API_KEY when proxying /api to the rankings stack.
# Generate e.g. with: openssl rand -hex 32 (never commit the real value)
BOT_API_KEY=change-me

# WordPress / MySQL — set your own passwords
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me
