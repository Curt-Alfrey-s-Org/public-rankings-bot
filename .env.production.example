# Rankings Bot — PRODUCTION env template (placeholders only; NEVER commit real values).
# Copy to the git-ignored ../.env used by production/docker-compose.prod.yml:
#   cp .env.production.example .env && chmod 600 .env   # then replace every CHANGE_ME
# Generate secrets with: openssl rand -hex 32
# Full reference: docs/ENV_VARS.md, docs/API_ACCESS_POLICY.md, docs/AUTH_DESIGN.md

# --- Mode ---------------------------------------------------------------------
# DEBUG unset/false = production: startup FAILS if JWT_SECRET, BOT_API_KEY or (on first
# boot) SUPER_ADMIN_PASSWORD is missing. Never set DEBUG=true in production.
DEBUG=false

# --- Secrets --------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Gates anonymous non-public /api/* requests (X-API-Key). Must match the value the
# USPBF nginx proxy injects (USPBF BOT_API_KEY).
BOT_API_KEY=CHANGE_ME_openssl_rand_hex_32
XAI_API_KEY=

# --- Database -------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=rankingsbot

# --- Bootstrap users (created at startup ONLY if missing; never overwritten) -----
# No default passwords exist. Passwords must have 8+ chars with upper, lower, digit and
# special character. Alternatively set <PREFIX>_PASSWORD_HASH to an Argon2/bcrypt hash.
# New bootstrap users must change their password at first login (enforced server-side).
# Do not use the username "admin": it is the login honeypot (blocks the caller's IP).
SUPER_ADMIN_USERNAME=CHANGE_ME_super_admin_username
SUPER_ADMIN_PASSWORD=CHANGE_ME
ADMIN_USERNAME=CHANGE_ME_admin_username
ADMIN_PASSWORD=CHANGE_ME
DIRECTOR_USERNAME=CHANGE_ME_director_username
DIRECTOR_PASSWORD=CHANGE_ME
USER_USERNAME=CHANGE_ME_user_username
USER_PASSWORD=CHANGE_ME
# Optional scorekeeper device account (skipped when no password is set)
SCORE_KEEPER_USERNAME=scorekeeper
SCORE_KEEPER_PASSWORD=

# --- Misc -----------------------------------------------------------------------
CORS_ORIGINS=https://probilliardssoftware.com,https://app.probilliardssoftware.com,https://example.com
PUBLIC_REGISTRATION_ENABLED=false
HOST_REPO_ROOT=/path/to/rankings-bot
