# Rankings Bot — LOCAL DEVELOPMENT env template (placeholders only; NEVER commit real values).
# Copy to the git-ignored .env for local runs: cp .env.development.example .env
DEBUG=true
LOG_LEVEL=DEBUG
# Required even in dev (api/auth.py refuses to import without it): openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Optional in dev (DEBUG=true): when empty the API key check is skipped with a warning.
BOT_API_KEY=
DATABASE_URL=postgresql://user:CHANGE_ME@localhost:5432/rankings_dev
# Bootstrap users are created only when a password is set (there is no default password).
SUPER_ADMIN_USERNAME=CHANGE_ME_local_super_admin
SUPER_ADMIN_PASSWORD=
DIRECTOR_USERNAME=director
DIRECTOR_PASSWORD=
USER_USERNAME=user
USER_PASSWORD=
